# === Дев (по умолчанию) ===
COMPOSE_PROJECT_NAME=habit-club

# === Telegram ===
BOT_TOKEN=                 # от @BotFather
WEBHOOK_SECRET=            # любой случайный токен для верификации webhook
WEBHOOK_BASE_URL=           # напр. https://your-domain.com
WEBHOOK_PATH=/bot/webhook
WEBAPP_URL=                 # URL Mini App (для кнопки в боте)

# === Backend ===
SERVICE_SECRET=            # общий секрет для service-token (HS256)
INIT_DATA_MAX_AGE_SECONDS=86400
SERVICE_TOKEN_TTL_SECONDS=60
LOG_LEVEL=INFO
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=https://web.telegram.org

# === Database ===
POSTGRES_DB=habits
POSTGRES_USER=habits
POSTGRES_PASSWORD=          # случайный сложный пароль
DATABASE_URL=postgresql+asyncpg://habits:${POSTGRES_PASSWORD}@postgres:5432/habits
DATABASE_URL_SYNC=postgresql+psycopg2://habits:${POSTGRES_PASSWORD}@postgres:5432/habits

# === Redis ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === Backups (Selectel S3) ===
S3_ENDPOINT_URL=https://s3.ru-1.storage.selcloud.ru
S3_BACKUP_BUCKET=habits-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_PUBLIC_KEY=         # age public key для шифрования

# === Мониторинг ===
SENTRY_DSN=
ADMIN_TELEGRAM_CHAT_ID=    # для алертов