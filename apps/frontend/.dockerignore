# Frontend build context exclusions — без этого `node_modules` и `dist`
# копируются в build context и конфликтуют с `npm ci` слоем в
# frontend.Dockerfile (ошибка "cannot replace to directory X with file").
# В Dockerfile: `COPY apps/frontend ./` копирует всё, поэтому мусорные
# артефакты из локального dev должны быть явно исключены.

node_modules
dist
dist-ssr
.local
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Tests / coverage
coverage
*.lcov
.nyc_output

# TS build info (не нужен в контейнере)
*.tsbuildinfo